      "optimized_expected": {
        "tokens_min": 1200,
        "tokens_max": 2000,
        "tool_calls": 8,
        "round_trips": 1,
        "characteristics": [
          "Core refactoring first",
          "Checkpoints for validation",
          "Assume + offer corrections",
          "Expansion offers for logging/tests"
        ]
      },
      "expected_savings": {
        "tokens": "40-50%",
        "tool_calls": "40-50%",
        "round_trips": "60-70%"
      }
    },
